<?xml version="1.0" encoding="utf-8"?>
<!--
    Conservative Android data extraction rules for MagnetVault (API 31+).
    Excludes local Room databases, DataStore/SharedPreferences, WebView cookies/caches,
    and external files from both cloud backup and device-to-device transfer.
    Manual JSON export remains available in Vault.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
