<?xml version="1.0" encoding="utf-8"?>
<!--
    Conservative Android Auto Backup rules for MagnetVault (API <= 30).
    Excludes local databases, DataStore/SharedPreferences, WebView cookies/caches,
    and external storage. Portable backups are user-triggered via Vault -> Export JSON.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
